{
  "manifest_version": 3,
  "name": "Pokemon Center - Auto Lottery & Checkout Bot",
  "version": "2.0.0",
  "description": "Tự động quét & nộp đơn bốc thăm, kiểm tra kết quả và thanh toán tự động Pokémon Center Online Japan",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png",
    "default_title": "Pokémon Center Lottery & Checkout Bot"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.pokemoncenter-online.com/*",
    "*://id.pokemoncenter-online.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.pokemoncenter-online.com/*",
        "*://id.pokemoncenter-online.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.pokemoncenter-online.com/*",
        "*://id.pokemoncenter-online.com/*"
      ],
      "js": [
        "page_script.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page_script.js",
        "styles.css",
        "icon.png"
      ],
      "matches": [
        "*://www.pokemoncenter-online.com/*",
        "*://id.pokemoncenter-online.com/*"
      ]
    }
  ]
}
