{
  "manifest_version": 3,
  "name": "Pokemon Center - Auto Lottery Bot",
  "version": "1.0.0",
  "description": "Tự động quét và đăng ký bốc thăm xổ số Pokémon Center Online Japan ngay sau khi đăng nhập",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.pokemoncenter-online.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.pokemoncenter-online.com/lottery/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.pokemoncenter-online.com/lottery/*"
      ],
      "js": [
        "page_script.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
